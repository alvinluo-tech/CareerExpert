# 个人求职配置模版 — 复制本文件为 config.yml 后填写个人真实信息
# ⚠️ 注意: config.yml 已在 .gitignore 中, 绝不会被推送到公开 Git 仓库

candidate:
  name: "张小明"
  current_title: "全栈开发工程师"
  years_of_experience: 3
  location_preference: ["北京", "上海", "远程"]
  work_auth_notes: "无特殊限制"

# 岗位族定义: 只有核心要求重叠 >= 70% 的岗位才共用一个简历版本
job_families:
  - id: fullstack-eng
    label: "全栈开发 / 后端研发"
    core_keywords: ["Go", "Python", "React", "分布式", "微服务", "高并发", "MySQL", "Redis"]
    master_resume: "resumes/base/fullstack-eng.md"
  - id: backend-infra
    label: "基础设施 / 云原生研发"
    core_keywords: ["Kubernetes", "Docker", "Go", "网关", "Prometheus", "服务治理"]
    master_resume: "resumes/base/backend-infra.md"

# 个人红线 (Dealbreakers): JD 出现以下情况时，评估报告会自动预警
dealbreakers:
  - "低于期望薪资下限"
  - "强制长期出差或不接受的通勤范围"
  - "缺乏实际业务场景的纯投机型项目"

# 投递跟进节奏 (Follow-up)
follow_up:
  default_days_after_apply: 7     # 投递后默认 7 天无响应触发跟进
  reminder_check: "会话启动时自动扫描 tracker.md 中到期的待办与面试日程"

# 统计分析渠道列表 (渠道漏斗转化率按此分组)
channels: ["boss直聘", "内推", "拉勾", "猎聘", "LinkedIn", "官网直投", "猎头推荐"]
